;;; amrit-light-theme-theme.el --- Amrit light theme -*- lexical-binding: t; -*-

(deftheme amrit-light-theme
  "Created 2026-10-08.")

(custom-theme-set-faces
 'amrit-light-theme
 '(default ((t (:inherit nil :extend nil :stipple nil :background "snow1" :foreground "#383a42" :inverse-video nil :box nil :strike-through nil :overline nil :underline nil :slant normal :weight regular :height 120 :width normal :family "Fira Code Retina"))))
 '(cursor ((t (:background "#4078f2"))))
 '(fixed-pitch ((t (:family "Monospace"))))
 '(variable-pitch ((((type w32)) (:foundry "outline" :family "Arial")) (t (:family "Sans Serif"))))
 '(escape-glyph ((t (:foreground "#0184bc" :inherit (aircon-brick)))))
 '(homoglyph ((t (:foreground "#884900" :inherit (aircon-brick)))))
 '(minibuffer-prompt ((t (:foreground "#4078f2" :inherit (modus-themes-prompt)))))
 '(highlight ((t (:foreground "#f0f0f0" :background "#4078f2" :inherit (aircon-haze)))))
 '(region ((t (:inherit aircon-athens :extend t :background "LavenderBlush1" :foreground "#000000"))))
 '(shadow ((t (:foreground "#9ca0a4" :inherit (aircon-scorpion)))))
 '(secondary-selection ((t (:extend t :foreground "#000000" :background "#9ca0a4" :inherit (aircon-prelude)))))
 '(trailing-whitespace ((t (:background "#e45649" :inherit (aircon-blush)))))
 '(font-lock-bracket-face ((t (:foreground "#000000" :inherit (font-lock-punctuation-face)))))
 '(font-lock-builtin-face ((t (:foreground "#a626a4" :inherit (modus-themes-bold)))))
 '(font-lock-comment-delimiter-face ((t (:foreground "#595959" :inherit (font-lock-comment-face)))))
 '(font-lock-comment-face ((t (:foreground "#9ca0a4" :inherit (modus-themes-slant)))))
 '(font-lock-constant-face ((t (:foreground "#b751b6" :inherit (aircon-eden)))))
 '(font-lock-delimiter-face ((t (:foreground "#000000" :inherit (font-lock-punctuation-face)))))
 '(font-lock-doc-face ((t (:slant italic :foreground "#84888b" :inherit (font-lock-comment-face)))))
 '(font-lock-doc-markup-face ((t (:foreground "#7c318f" :inherit (modus-themes-slant)))))
 '(font-lock-escape-face ((t (:inherit (font-lock-regexp-grouping-backslash)))))
 '(font-lock-function-call-face ((t (:slant italic :foreground "#852c86" :inherit (font-lock-function-name-face)))))
 '(font-lock-function-name-face ((t (:foreground "#a626a4" :inherit (aircon-grape)))))
 '(font-lock-keyword-face ((t (:foreground "#e45649" :inherit (modus-themes-bold)))))
 '(font-lock-negation-char-face ((t (:foreground "#4078f2" :inherit (bold)))))
 '(font-lock-number-face ((t (:foreground "#da8548"))))
 '(font-lock-misc-punctuation-face ((t (:inherit (font-lock-punctuation-face)))))
 '(font-lock-operator-face ((t (:foreground "#4078f2"))))
 '(font-lock-preprocessor-face ((t (:foreground "#4078f2" :inherit (bold)))))
 '(font-lock-property-name-face ((t (:weight bold :foreground "#9f4a46"))))
 '(font-lock-property-use-face ((t (:weight regular :inherit (font-lock-property-name-face)))))
 '(font-lock-punctuation-face ((t (:foreground "#3a496e"))))
 '(font-lock-regexp-grouping-backslash ((t (:foreground "#4078f2" :inherit (bold)))))
 '(font-lock-regexp-grouping-construct ((t (:foreground "#4078f2" :inherit (bold)))))
 '(font-lock-string-face ((t (:foreground "#50a14f" :inherit (aircon-goblin)))))
 '(font-lock-type-face ((t (:foreground "#986801" :inherit (modus-themes-bold)))))
 '(font-lock-variable-name-face ((t (:foreground "#6a1868" :inherit (aircon-lilac)))))
 '(font-lock-variable-use-face ((t (:foreground "#512855" :inherit (font-lock-variable-name-face)))))
 '(font-lock-warning-face ((t (:foreground "#884900" :inherit (warning)))))
 '(button ((t (:underline (:color "#3548cf" :style line :position nil) :foreground "#3548cf"))))
 '(link ((t (:weight bold :underline (:color foreground-color :style line :position nil) :foreground "#4078f2" :inherit (aircon-sapphire underline)))))
 '(link-visited ((t (:underline (:color "#721045" :style line :position nil) :foreground "#721045" :inherit (aircon-lilac link)))))
 '(fringe ((t (:foreground "#9ca0a4" :inherit (default)))))
 '(header-line ((t (:inherit (mode-line)))))
 '(tooltip ((t (:foreground "#383a42" :background "#e7e7e7" :inherit (aircon-linen)))))
 '(mode-line ((t (:box (:line-width (1 . 1) :color "#5a5a5a" :style nil) :foreground "#383a42" :background "#e7e7e7" :inherit (modus-themes-ui-variable-pitch)))))
 '(mode-line-buffer-id ((t (:weight bold :inherit (bold)))))
 '(mode-line-emphasis ((t (:foreground "#4078f2" :inherit (italic)))))
 '(mode-line-highlight ((t (:box (:line-width (1 . 1) :color "#000000" :style nil) :foreground "#000000" :background "#b2e4dc" :inherit (highlight)))))
 '(mode-line-inactive ((t (:box (:line-width (1 . 1) :color "#a3a3a3" :style nil) :foreground "#a190a7" :background "#e1e1e1" :inherit (modus-themes-ui-variable-pitch)))))
 '(isearch ((t (:weight bold :foreground "#000000" :background "#f3d000" :inherit (lazy-highlight)))))
 '(isearch-fail ((t (:weight bold :foreground "#f0f0f0" :background "#e45649" :inherit (aircon-blush)))))
 '(lazy-highlight ((t (:foreground "#f0f0f0" :background "#c2d3f7" :inherit (aircon-linen)))))
 '(match ((t (:weight bold :foreground "#50a14f" :background "#f0f0f0" :inherit (aircon-linen)))))
 '(next-error ((t (:foreground "#000000" :background "#ff8f88"))))
 '(query-replace ((t (:foreground "#000000" :background "#ff8f88")))))

(provide-theme 'amrit-light-theme)
